# Runtime artifacts.
RL_CHECKPOINT=logs/rsl_rl/unitree_g1_flat_robust/<run>/model_*.pt
GR00T_CHECKPOINT=checkpoints/groot-g1-navigation/checkpoint-20000
GR00T_DATASET=datasets/lerobot/g1_navigation
GR00T_SERVER_HOST=127.0.0.1
GR00T_SERVER_PORT=5555

# Set to 1 only after reading and accepting NVIDIA's EULA.
OMNI_KIT_ACCEPT_EULA=0
