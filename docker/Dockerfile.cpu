FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY configs ./configs
RUN python -m pip install --no-cache-dir .

ENTRYPOINT ["gr00t-g1"]
CMD ["demo", "--episodes", "3", "--output", "/artifacts/mock_demo"]
